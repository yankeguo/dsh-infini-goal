{
  "name": "@yankeguo/dsh-disable-goal-bundle",
  "version": "0.2.0",
  "description": "Turns the built-in dsh-goal mode (automatic rounds, GoalBar, /goal command, and goal tools) off as an ordinary toggleable bundle layer.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    }
  },
  "exports": {
    ".": "./lib/preset-filter.js",
    "./preset-filter": "./lib/preset-filter.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "locale/*.json"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankeguo/dsh-infini-goal.git",
    "directory": "packages/disable-goal-bundle"
  },
  "homepage": "https://github.com/yankeguo/dsh-infini-goal#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent-preset": "0.2.2-rc.1"
  }
}
