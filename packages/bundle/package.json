{
  "name": "@yankeguo/dsh-infini-goal-bundle",
  "version": "0.2.1",
  "description": "Endless goal mode for DeepSeek Harness: no round cap, a minimum trigger interval, and quiet time windows that suppress automatic rounds; installing it also switches the built-in dsh-goal mode off by default.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./cordis.disable-goal.patch.yml"
      ],
      "listedByDefault": false
    }
  },
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./cordis.disable-goal.patch.yml": "./cordis.disable-goal.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "cordis.disable-goal.patch.yml",
    "icon.svg",
    "README.md",
    "locale/*.json"
  ],
  "dependencies": {
    "@yankeguo/dsh-disable-goal-bundle": "workspace:*",
    "@yankeguo/dsh-infini-goal": "workspace:*",
    "@yankeguo/dsh-infini-goal-driver": "workspace:*",
    "@yankeguo/dsh-tool-infini-goal": "workspace:*",
    "@yankeguo/dsh-command-infini-goal": "workspace:*",
    "@yankeguo/dsh-client-ui-infini-goal": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankeguo/dsh-infini-goal.git",
    "directory": "packages/bundle"
  },
  "homepage": "https://github.com/yankeguo/dsh-infini-goal#readme"
}
