{
  "name": "dsh-infini-goal",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Endless goal continuation plugin suite for DeepSeek Harness: no round cap, a configurable minimum trigger interval, and quiet time windows that suppress automatic rounds.",
  "license": "MIT",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node scripts/clean.mjs",
    "dev:patch": "node scripts/dev-patch.mjs",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run build",
    "install:profile": "node scripts/install-profile.mjs",
    "uninstall:profile": "node scripts/install-profile.mjs --uninstall",
    "release:check": "node scripts/stage-release.mjs --check",
    "release:stage": "pnpm build && node scripts/stage-release.mjs",
    "release:stage:dry": "pnpm build && node scripts/stage-release.mjs --dry-run --no-git-checks",
    "release:promote": "node scripts/promote-release.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  }
}
